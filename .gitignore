# Godot 4+ specific ignores
.godot/

# Python cache
__pycache__/
*.pyc

# Local Corruptor patch backups / audit artifacts
.corruptor_backups/
CASTLE_RULES_LOCK_AUDIT_*.txt

# Local development artifacts
Backups/
Experiments/

# Patch / temporary source backups
*_bak
*.bak

# Office / LibreOffice lock files
.~lock.*#
~$*

# Local experiment/report output
/*_seed*.txt
/*_validate.txt
/*_audit*.txt
/diagnose_*.txt

# Local title shader iteration backups
Prototype/TitleScreen/*.before_*
